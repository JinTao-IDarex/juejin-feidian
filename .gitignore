# 生成产物
output/
_bak/
data/align.txt
data/_view.txt
# 魔鬼榜单的抓取+评分缓存（含他人沸点正文与 AI 分数，属生成物，不入库）
data/board/

# 榜单形象图的 AI 原图留档（归一化前的 1024x768 大图，2.7MB；
# 入库的是 assets/board-cards/cN-*.png 归一化成品）
assets/board-cards/_raw/

# 本地密钥配置（模板见 site/.ai-config.example.json）
# 通配所有变体（含「副本」「backup」等文件名，真实 token 绝不入库）
site/.ai-config*

# 素材备份目录
assets/board-cards/_bak-char/

# 本地供应商覆盖（模板见 site/providers.local.example.json）
providers.local.json

# CRX 打包产物与私钥（pem 泄露 = 别人可伪造你的扩展，绝不入库）
extension.pem
extension.crx
