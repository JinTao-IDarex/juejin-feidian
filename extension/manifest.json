{
  "manifest_version": 3,
  "name": "沸点抽卡 · 掘金沸点翻牌",
  "version": "0.2.7",
  "description": "在 juejin.cn 上悬浮站点同款的主卡与缩略卡：翻牌看当日沸点，配一句 AI 点评。不登录、不上传、不代发。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [],
  "host_permissions": [
    "*://*.juejin.cn/*",
    "https://api.juejin.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.juejin.cn/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "沸点抽卡：显示 / 收起浮层",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "host.html",
        "app.css",
        "app.js",
        "data.js",
        "embed.css",
        "embed-boot.js",
        "api-shim.js",
        "icons/*"
      ],
      "matches": ["*://*.juejin.cn/*"]
    }
  ]
}
